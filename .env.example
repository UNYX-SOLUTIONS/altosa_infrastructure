POSTGRES_USER=altosa_admin
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=altosa
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=CHANGE_ME
PGADMIN_PUBLIC_PORT=5050

# API interna (altosa-api). Solo accesible dentro de la red Docker altosa_backend;
# la consume el backend del ERP Unyx con el header x-api-key.
ALTOSA_API_KEY=CHANGE_ME_random_string_min_16_chars

# URL pública base para las imágenes subidas y dominio del API (HTTPS del
# subdominio del cliente en ESTE VPS; el ERP de otro VPS consume /api/v1 aquí).
ALTOSA_PUBLIC_URL_BASE=https://api.altosamobiliario.com
ALTOSA_PUBLIC_DOMAIN=api.altosamobiliario.com
