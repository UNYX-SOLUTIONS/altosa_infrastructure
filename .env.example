POSTGRES_USER=altosa_admin
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=altosa
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=CHANGE_ME
PGADMIN_PUBLIC_PORT=5050
# Dominio HTTPS del pgAdmin (resuelve a este VPS)
PGADMIN_PUBLIC_DOMAIN=dbglobal.altosamobiliario.com

# API altosa-api: escucha en altosa_backend:4100 y se publica por Traefik
# en ALTOSA_PUBLIC_DOMAIN. El backend del ERP la consume con el header
# x-api-key. Usa la MISMA clave en el .env.production del ERP.
ALTOSA_API_KEY=CHANGE_ME_random_string_min_16_chars

# URL pública base para las imágenes subidas y dominio del API (HTTPS del
# subdominio del cliente en ESTE VPS; el ERP de otro VPS consume /api/v1 aquí).
ALTOSA_PUBLIC_URL_BASE=https://api.altosamobiliario.com
ALTOSA_PUBLIC_DOMAIN=api.altosamobiliario.com

# Kommo - plantillas de chat (token de larga duración)
KOMMO_API_URL=https://altosa.kommo.com
KOMMO_API_KEY=

# Meta - token de System User (ALTOSA), solo server-side.
META_CATALOG_ID=1524398256394561
# Secreto: no versionar. Pegar el token aquí en el .env real.
META_ACCESS_TOKEN=
META_API_VERSION=v26.0
