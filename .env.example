POSTGRES_USER=altosa_admin
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=altosa
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=CHANGE_ME
PGADMIN_PUBLIC_PORT=5050

# API interna (altosa-api). Solo accesible dentro de la red Docker altosa_backend;
# la consume el backend del ERP Unyx con el header x-api-key.
ALTOSA_API_KEY=CHANGE_ME_random_string_min_16_chars

# URL pública base para las imágenes subidas (debe ser el dominio por el que el
# navegador llega a /uploads; en local: http://localhost:4100).
ALTOSA_PUBLIC_URL_BASE=https://altosa-test.erp.unyxsolutions.com
ALTOSA_PUBLIC_DOMAIN=altosa-test.erp.unyxsolutions.com
