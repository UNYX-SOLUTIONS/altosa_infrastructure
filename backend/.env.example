# ============================================================================
# altosa-api - Entorno LOCAL (pnpm dev, scripts y Prisma CLI)
# Copia este archivo a backend/.env y ajusta los valores.
# NO uses este archivo para Docker/producción y NO lo subas al repositorio.
# No incluye POSTGRES_* ni PGADMIN_*: en producción viven en el .env raíz
# y Compose los traduce. Las claves comunes con producción son KOMMO_* y META_*.
# ============================================================================

NODE_ENV=development
PORT=4199

# PostgreSQL local (el puerto puede variar; revisa tu docker-compose local)
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5499/altosa?schema=public

# Debe coincidir con ALTOSA_API_KEY del backend del ERP que consuma este API local
API_KEY=local-dev-api-key-change-me-min-16

UPLOAD_DIR=uploads
PUBLIC_URL_BASE=http://localhost:4199

# ============================================================================
# Variables comunes con producción: mismos nombres y valores de URL/catálogo/versión.
# ============================================================================
# Kommo (opcional en local)
KOMMO_API_URL=https://altosa.kommo.com
KOMMO_API_KEY=

# Meta (opcional en local; solo para probar el selector/mapeo)
# Usa el mismo System User token de ALTOSA si quieres probar contra el catálogo real.
META_CATALOG_ID=1524398256394561
META_ACCESS_TOKEN=
META_API_VERSION=v26.0
